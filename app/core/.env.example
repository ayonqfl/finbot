# PostgreSQL reachable from the Docker container.
# For a database running on the host machine, use host.docker.internal instead of localhost.
FINANCIAL_DB_URI=postgresql+psycopg2://username:password@host.docker.internal:5432/stockdb

# Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Optional; defaults to Google's Generative Language API.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
